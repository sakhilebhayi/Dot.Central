APP_NAME="Dot.Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://central.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ecosystem SSO: InfoDot proves handoff tokens (this app has its own database).
# If any of the three settings below is wrong, people arrive from InfoDot and land on a login page or a "cannot sign you
# in" page, which looks like being logged out. Check with:  php artisan sso:check  (the same check is in the Guardian
# report as sso_receiver_configured). After editing .env on a host that caches config, run php artisan config:cache.
#  - INFODOT_SERVICE_SECRET: blank = nobody can sign in. A wrong value = InfoDot answers 401 (logged as secret_rejected).
#  - INFODOT_REDEEM_URL: its HOST must equal InfoDot's public host (DOT_INFODOT_URL, default https://infodot.co.za). A
#    sibling such as www. or an IP makes every sign-in InfoDot sends look like it came from the wrong site.
#  - INFODOT_PLATFORM_KEY: central.
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_CENTRAL in InfoDot's .env, and
# INFODOT_PLATFORM_KEY must be this platform's key there. Leave the secret blank to
# accept only tokens found in this app's own database (shared-database behaviour).
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=central
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true
# While someone is signed in, ask InfoDot whether their current company still holds Dot.Central (answer cached 10
# minutes per company; any failure lets the person carry on). Set false to switch the check off.
CENTRAL_ENTITLEMENT_CHECK=true

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Where "Create an account" goes while public sign-up here is closed (an account starts on InfoDot).
DOT_SIGNUP_URL=https://infodot.co.za/register

# R-54 central sign-in through InfoDot (packages/dot-sso-client). Off by default: nothing changes until DOTSSO_ENABLED=true.
# Register this platform on the InfoDot host first (`php artisan sso:platform register central ...`, see docs/dot-central/R54-central-sign-in.md).
DOTSSO_ENABLED=false
DOTSSO_ISSUER=https://infodot.co.za
DOTSSO_CLIENT_ID=
DOTSSO_CLIENT_SECRET=
DOTSSO_ALLOW_LOCAL_LOGIN=false
